```gitignore
# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# Environment variables and secrets
.env
.env.local
.env.*.local
*.env

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
scratch/
.pytest_cache/

# Datasets
data/*.csv

# Trained models
models/*.pkl

# Node.js and frontend build files
node_modules/
frontend/node_modules/
frontend/dist/
dist/
```